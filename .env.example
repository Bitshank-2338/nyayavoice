# NyayaVoice — Google AI (optional)
# Leave blank to use the built-in offline engine. Set this on Cloud Run as a secret env var.
GEMINI_API_KEY=

# Voice stays in the browser. No extra voice vendor is required.
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Local app URL. Cloud Run sets its own URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
