# NyayaVoice — Google AI (optional)
# Leave blank to use the built-in offline engine. Set this on Cloud Run as a secret env var.
GEMINI_API_KEY=

# Voice stays in the browser. No extra voice vendor is required.
NEXT_PUBLIC_VOICE_PROVIDER=browser

# Local app URL. Cloud Run sets its own URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (Auth.js). Create an OAuth client in Google Cloud and add the redirect
# http://localhost:3000/api/auth/callback/google plus the Cloud Run callback URL.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Firestore project for per-user history. On Cloud Run the service account token is read from the metadata server.
GOOGLE_CLOUD_PROJECT=
